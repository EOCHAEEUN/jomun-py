# .env.example → 복사해서 파일 이름을 .env 로 바꾸고 값을 넣으세요.
# (.env는 깃허브에 올리지 않습니다)

# OpenAI 키가 있으면 LLM으로 서비스 특성을 추출하고, 없으면 규칙 기반 추출기로 동작해요.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# 특성 추출기: auto(키 있으면 LLM) | llm | heuristic
FEATURE_EXTRACTOR=auto

# 임베딩: local(키 없이 동작, 데모·Naive 베이스라인용) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
COLLECTION_NAME=law_articles
RETRIEVAL_TOP_K=5
